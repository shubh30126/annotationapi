{
  "name": "AnnotationAPIDemo",
  "version": "1.0.0",
  "private": false,
  "license": "See license in license.md",
  "dependencies": {
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "classnames": "^2.3.2",
    "clsx": "^1.2.1",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "react-icons": "^4.12.0",
    "react-scripts": "^4.0.3"
  },
  "scripts": {
    "copy:viewsdk": "mkdir -p public/viewsdk && cp -r viewsdk/* public/viewsdk/",
    "prestart": "npm run copy:viewsdk",
    "start": "export NODE_OPTIONS=--openssl-legacy-provider && react-scripts start",
    "prebuild": "npm run copy:viewsdk",
    "build": "export NODE_OPTIONS=--openssl-legacy-provider && react-scripts build",
    "clean": "rm -rf node_modules package-lock.json"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}